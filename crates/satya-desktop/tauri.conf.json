{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SATYA",
  "version": "0.1.0",
  "identifier": "org.satya.forensics",
  "build": {
    "devUrl": "http://127.0.0.1:8000"
  },
  "app": {
    "windows": [
      {
        "title": "SATYA \u2014 DVR Forensic Analyzer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "url": "http://127.0.0.1:8000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}